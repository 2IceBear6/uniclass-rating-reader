{
  "name": "uniclass-rating-reader",
  "version": "1.0.0",
  "description": "UniClass Rating & Review Reader - Thu thập, lưu trữ và phân tích dữ liệu đánh giá UniClass",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "crawl": "tsx src/cli/crawl.ts",
    "build:static": "tsx src/cli/export-static.ts"
  },
  "keywords": [
    "uniclass",
    "rating",
    "review",
    "google-play",
    "app-store"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "node-cron": "^4.6.0",
    "playwright": "^1.65.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
